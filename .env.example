# Копирайте като .env.local за локална разработка и задайте същите стойности
# във Vercel → Settings → Environment Variables.

# --- Календар за запазване на час (Cal.com) ---
# Формат: "<акаунт>/<event>", напр. "dr-di-clinic/konsultacia".
# Трябва да е акаунт НА КЛИНИКАТА с ПРИСЪСТВЕН event (адресът на клиниката,
# не "Cal Video"). Ако е празно, бутоните „Запази час" водят към контактната
# форма — сайтът работи, но без онлайн календар.
VITE_CAL_LINK=

# --- Контактна форма (Resend) ---
# Само за сървърната функция api/contact.js. Без RESEND_API_KEY формата
# връща 503 и показва телефона като резервен канал (никога фалшив успех).
RESEND_API_KEY=
CONTACT_TO=drdiclinic21@gmail.com
# До верифициране на домейн в Resend ползвайте onboarding@resend.dev.
CONTACT_FROM=Dr. Di Clinic <onboarding@resend.dev>
